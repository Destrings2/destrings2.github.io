{
  "name": "rota",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:all": "npm run test && npm run test:db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.79.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true
  }
}
